FROM python:3.12-slim

WORKDIR /app
RUN mkdir -p /app/src/indexing

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Clone and install LightRAG
RUN git clone https://github.com/HKUDS/LightRAG.git && \
    pip install --no-cache-dir -e ./LightRAG

# Install additional dependencies
RUN pip install --no-cache-dir \
    flask \
    gunicorn \
    requests \
    ollama \
    openai \
    pypdf \
    pyyaml \
    nest_asyncio \
    cryptography

# Copy application files
COPY src/integrations/lightrag_service.py ./lightrag_service.py
COPY src/indexing/frontmatter.py ./src/indexing/frontmatter.py

# Create database directory
RUN mkdir -p /app/lightrag_db /app/vault

# Expose port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Run the service
CMD ["gunicorn", "-w", "2", "-k", "gthread", "--threads", "2", "-b", "0.0.0.0:8001", "lightrag_service:app"]
