FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements_graphrag_simple.txt requirements.txt
RUN pip install --no-cache-dir -r requirements_graphrag_simple.txt || \
    pip install --no-cache-dir graphrag flask pyyaml requests

# Copy application files
COPY graphrag_unified_service.py graphrag_service.py
COPY graphrag_local_patch.py .

# Create directories
RUN mkdir -p /app/graphrag_db /app/vault

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV GRAPHRAG_DIR=/app/graphrag_db
ENV OLLAMA_HOST=http://host.docker.internal:11434

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

# Expose port
EXPOSE 8002

# Run unified GraphRAG service
CMD ["python", "graphrag_unified_service.py"]