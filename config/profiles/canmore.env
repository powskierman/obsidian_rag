# Canmore home-base runtime profile
DEEP_THINKING_PROVIDER=openrouter
DEEP_THINKING_MODEL=nvidia/nemotron-3-super-120b-a12b:free

DEFAULT_LLM_PROVIDER=openrouter
CASCADING_LLM_PROVIDER=openrouter
LLM_PROVIDER=openrouter
QUERY_LLM_PROVIDER=openrouter

LIGHTRAG_EMBED_MODEL=nomic-embed-text
