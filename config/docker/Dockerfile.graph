FROM python:3.12-slim

WORKDIR /app
ENV PYTHONPATH=/app

# Install curl first and clean up in same layer to save space
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Install dependencies
RUN pip install --no-cache-dir \
    openai \
    flask \
    flask-cors \
    networkx \
    tqdm \
    requests \
    tavily-python \
    anthropic \
    mem0ai \
    pypdf \
    cryptography \
    PyYAML

# Copy the application package so service modules run with the same package root
# in Docker and local development.
COPY src /app/src

# Expose port
EXPOSE 8002

# Run service
CMD ["python", "-m", "src.services.graph_query_service"]
