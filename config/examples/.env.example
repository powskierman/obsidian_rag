# GraphRAG vs LightRAG Service Selection
# Set to 'lightrag' or 'graphrag'
GRAPH_SERVICE=graphrag

# Model Configuration
LLM_MODEL=qwen2.5-coder:14b
EMBED_MODEL=nomic-embed-text

# Ollama Configuration
OLLAMA_HOST=http://host.docker.internal:11434

# Optional PDF tree retrieval provider configuration
PDF_TREE_RETRIEVAL_ENABLED=false
PDF_TREE_PROVIDER=ollama
PDF_TREE_MODEL=llama3.1:8b
PDF_TREE_INDEX_DIR=/app/pdf_tree_index
PDF_TREE_INDEX_HOST_DIR=./data/pdf_tree_index
PDF_TREE_TIMEOUT_SECONDS=120
PDF_TREE_MAX_TOKENS=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=local-model
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=obsidian_rag
